<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:CalculadoraDeSalarios.App.Controls">

    <Style Selector="Window">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Inter, Segoe UI Variable, Segoe UI, Noto Sans, Cantarell, sans-serif" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBackdropBrush}" />
    </Style>
    <Style Selector="Window.reduce-motion Button">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Window.reduce-motion Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Window.reduce-motion Border">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.sub">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.card:not(.d1):not(.d2):not(.d3):not(.d4):not(.d5):not(.d6):not(.d7):not(.d8)">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.kpi:not(.d1):not(.d2):not(.d3):not(.d4):not(.d5):not(.d6):not(.d7):not(.d8)">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.d1">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Delay="0:0:0.05" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.d2">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Delay="0:0:0.10" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.d3">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Delay="0:0:0.15" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.d4">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Delay="0:0:0.20" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.d5">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Delay="0:0:0.25" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.d6">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Delay="0:0:0.30" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.d7">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Delay="0:0:0.35" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.d8">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Delay="0:0:0.40" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.Progress" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.Progress" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="BoxShadow" Value="0 4 20 0 #20000000, 0 1 2 0 #10000000" />
    </Style>

    <Style Selector="Border.card.interactive">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.card.interactive:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #33000000, 0 2 4 0 #18000000" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderStrongBrush}" />
    </Style>

    <Style Selector="Border.kpi">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="BoxShadow" Value="0 4 18 0 #1C000000, 0 1 2 0 #0E000000" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.kpi:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #33000000, 0 2 4 0 #18000000" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.kpi.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BoxShadow" Value="0 4 20 0 #4056C1C8, 0 1 3 0 #1A000000" />
    </Style>
    <Style Selector="Border.kpi.primary:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
        <Setter Property="BoxShadow" Value="0 8 28 0 #6656C1C8, 0 2 6 0 #26000000" />
    </Style>

    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.topbar">
        <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.glass">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BoxShadow" Value="0 4 18 0 #1C000000" />
    </Style>

    <Style Selector="Button">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="QuadraticEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.nav:pointerover">
        <Setter Property="RenderTransform" Value="translateX(3px)" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryGlowBrush}" />
        <Setter Property="BoxShadow" Value="0 2 12 0 #2056C1C8" />
    </Style>

    <Style Selector="Border.navbar">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="BoxShadow" Value="0 0 8 0 #8056C1C8" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.navbar.on">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #3356C1C8" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-1px)" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHiBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #5956C1C8" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryLoBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 1 4 0 #2656C1C8" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.icon-btn">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BoxShadow" Value="0 0 0 3 #4D56C1C8" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.daynum">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.daynum.dom">
        <Setter Property="Foreground" Value="{DynamicResource DomBrush}" />
    </Style>

    <Style Selector="Button.daycell">
        <Setter Property="MinHeight" Value="74" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_DayCellBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.daycell /template/ Border#PART_DayCellBorder">
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.daycell:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.03)" />
        <Setter Property="ZIndex" Value="10" />
    </Style>
    <Style Selector="Button.daycell:pointerover /template/ Border#PART_DayCellBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BoxShadow" Value="0 4 14 0 #33000000" />
    </Style>
    <Style Selector="Button.daycell.dom /template/ Border#PART_DayCellBorder">
        <Setter Property="Background" Value="{DynamicResource DomSoftBrush}" />
    </Style>
    <Style Selector="Button.daycell.dom:pointerover /template/ Border#PART_DayCellBorder">
        <Setter Property="Background" Value="{DynamicResource DomSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DomBrush}" />
    </Style>
    <Style Selector="Button.daycell.today /template/ Border#PART_DayCellBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.daycell.outside">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.daycell.placeholder">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="IsEnabled" Value="False" />
    </Style>

    <Style Selector="Button.empchip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.empchip /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.empchip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="Button.empchip.sel /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.addchip">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    </Style>
    <Style Selector="Button.addchip /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    </Style>
    <Style Selector="Button.addchip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="StackPanel.emptable">
        <Setter Property="MinWidth" Value="560" />
    </Style>
    <Style Selector="StackPanel.emptable.incl">
        <Setter Property="MinWidth" Value="880" />
    </Style>
    <Style Selector="Border.dayrow.outside">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.dom">
        <Setter Property="Foreground" Value="{DynamicResource DomBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Window:not(.reduce-motion) Border.toast">
        <Style.Animations>
            <Animation Duration="0:0:0.35" Easing="BackEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ctl:Reveal.ProgressX" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ctl:Reveal.ProgressX" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.toast">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BoxShadow" Value="0 8 28 0 #4D000000, 0 1 4 0 #1A000000" />
    </Style>
    <Style Selector="Border.toast.ok">
        <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="Border.toast.warn">
        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="Border.toast.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.toast.info">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
</Styles>
