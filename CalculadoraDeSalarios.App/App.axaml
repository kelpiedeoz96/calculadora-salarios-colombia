<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CalculadoraDeSalarios.App.Converters"
             x:Class="CalculadoraDeSalarios.App.App"
             RequestedThemeVariant="Default">
        <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/ColorTokens.axaml" />
                <ResourceInclude Source="/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ResourceKeyToGeometryConverter x:Key="ResToGeo" />
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
