<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CalculadoraDeSalarios.App.Controls"
             xmlns:vm="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Historial"
             x:Class="CalculadoraDeSalarios.App.Views.HistorialView"
             x:DataType="vm:HistorialViewModel">
    <ScrollViewer Padding="28,20,28,40">
        <StackPanel Spacing="16">
            <Border Classes="card d1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Copias de seguridad automáticas" Classes="h2" />
                    <TextBlock Text="Se guardan hasta 25 estados anteriores en este equipo. Puedes restaurarlos cuando lo necesites."
                               FontSize="12"
                               Foreground="{DynamicResource Text3Brush}"
                               TextWrapping="Wrap" />
                    <!-- Sin copias -->
                    <StackPanel Spacing="4" Margin="0,14" IsVisible="{Binding IsEmpty}">
                        <TextBlock Text="Sin copias guardadas" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Se crean automáticamente al hacer cambios importantes." FontSize="12"
                                   Foreground="{DynamicResource Text2Brush}" />
                    </StackPanel>
                    <!-- Copias -->
                    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistorialRowViewModel">
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Reason}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding When}" FontSize="12"
                                                       Foreground="{DynamicResource Text2Brush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost"
                                                Command="{Binding RestoreCommand}"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:Icon Data="{DynamicResource IconHistory}" Size="14"
                                                               Foreground="{DynamicResource Text2Brush}" />
                                                <TextBlock Text="Restaurar" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Acciones -->
                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Command="{Binding DescargarRespaldoCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconDownload}" Size="16"
                                               Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Descargar respaldo JSON" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CargarRespaldoCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconUpload}" Size="16"
                                               Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Cargar respaldo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="danger" Command="{Binding BorrarTodoCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconTrash}" Size="16"
                                               Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="Borrar todo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
