
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CalculadoraDeSalarios.App.Controls"
             xmlns:conv="clr-namespace:CalculadoraDeSalarios.App.Converters"
             xmlns:vm="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Liquidacion"
             x:Class="CalculadoraDeSalarios.App.Views.LiquidacionView"
             x:DataType="vm:LiquidacionViewModel">
    <ScrollViewer Padding="28,20,28,40">
        <StackPanel Spacing="16">
            <!-- 1. FILA DE EMPLEADOS (CHIPS) -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ItemsControl ItemsSource="{Binding EmployeeChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmployeeChipViewModel">
                            <Button Command="{Binding $parent[UserControl].((vm:LiquidacionViewModel)DataContext).SelectEmployeeCommand}"
                                    CommandParameter="{Binding Id}"
                                    Classes="empchip"
                                    Classes.sel="{Binding IsSelected}"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:EmpleadoAvatar Width="28" Height="28" CornerRadius="8" InitialsFontSize="11"
                                                  Initials="{Binding Initials}" Fill="{Binding AvatarBrush}" PhotoRelPath="{Binding PhotoRelPath}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Text="{Binding PayFormatted}" Classes="caption" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Botón Añadir Empleado -->
                <Button Grid.Column="1"
                        Command="{Binding AddEmployeeCommand}"
                        Classes="addchip"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Data="{DynamicResource IconPlus}" Size="14" Foreground="{DynamicResource Text2Brush}" />
                        <TextBlock Text="Añadir empleado" FontWeight="SemiBold" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Grid>
            <!-- ESTADO VACÍO (Si no hay empleados) -->
            <Border Classes="card d1" IsVisible="{Binding HasNoEmployees}">
                <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,32">
                    <controls:Icon Data="{DynamicResource IconUsers}" Size="36" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sin empleados" Classes="h2" HorizontalAlignment="Center" />
                    <TextBlock Text="Agrega un empleado para comenzar." Classes="sub" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <!-- CONTENIDO DE LIQUIDACIÓN (Si hay empleados) -->
            <StackPanel Spacing="16" IsVisible="{Binding HasEmployees}">
                <!-- 2. DATOS DEL EMPLEADO + SEMANAS -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <!-- Tarjeta Datos -->
                    <Border Classes="card d2">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Datos del empleado" Classes="h2" />
                            <!-- Foto del empleado (opcional) -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <controls:EmpleadoAvatar Width="72" Height="72" CornerRadius="18" InitialsFontSize="24"
                                                         Initials="{Binding EmpInitials}"
                                                         Fill="{Binding EmpAvatarBrush}"
                                                         PhotoRelPath="{Binding EmpPhotoRelPath}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="Foto del empleado (opcional)" Classes="caption" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding ElegirFotoCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:Icon Data="{DynamicResource IconUpload}" Size="16" Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="Subir foto…" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="danger" Command="{Binding QuitarFotoCommand}" IsVisible="{Binding HasEmpPhoto}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:Icon Data="{DynamicResource IconTrash}" Size="16" Foreground="{DynamicResource DangerBrush}" />
                                                <TextBlock Text="Quitar" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Nombre" Classes="caption" />
                                <TextBox Text="{Binding EmpName}" Tag="name" LostFocus="OnFormLostFocus" KeyDown="OnFormKeyDown" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Cédula" Classes="caption" />
                                    <TextBox Text="{Binding EmpCedula}" Tag="cedula" LostFocus="OnFormLostFocus" KeyDown="OnFormKeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Cargo" Classes="caption" />
                                    <TextBox Text="{Binding EmpCargo}" Tag="cargo" LostFocus="OnFormLostFocus" KeyDown="OnFormKeyDown" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Salario mensual (vacío = mínimo)" Classes="caption" />
                                    <TextBox Text="{Binding EmpSalarioText}" Tag="salario" PlaceholderText="{Binding SmmlvPlaceholder}" LostFocus="OnFormLostFocus" KeyDown="OnFormKeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Día de descanso semanal" Classes="caption" />
                                    <ComboBox SelectedIndex="{Binding EmpRestDayIndex}" SelectionChanged="OnRestDayChanged" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Sin definir" />
                                        <ComboBoxItem Content="Domingo" />
                                        <ComboBoxItem Content="Lunes" />
                                        <ComboBoxItem Content="Martes" />
                                        <ComboBoxItem Content="Miércoles" />
                                        <ComboBoxItem Content="Jueves" />
                                        <ComboBoxItem Content="Viernes" />
                                        <ComboBoxItem Content="Sábado" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SalarioBelowMinText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12"
                                       IsVisible="{Binding IsSalarioBelowMin}" />
                            <CheckBox Content="Recibe auxilio de transporte"
                                      IsChecked="{Binding EmpAux}"
                                      Click="OnAuxClick" />
                            <Button Command="{Binding DeleteEmployeeCommand}" Classes="danger" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:Icon Data="{DynamicResource IconTrash}" Size="14" Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="Eliminar empleado" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- Tarjeta Semanas -->
                    <Border Grid.Column="1" Classes="card d3">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Semanas" Classes="h2" />
                                <TextBlock Grid.Column="1" Text="{Binding PeriodLabel}" Classes="caption" />
                            </Grid>
                            <TextBlock Text="{Binding WeekCapText}" Classes="sub" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Weeks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeekRowViewModel">
                                        <StackPanel Spacing="4" Margin="0,4,0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding DateRangeLabel}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Grid.Column="1" Text="{Binding HoursLabel}" Classes="sub" />
                                            </Grid>
                                            <controls:WeekGauge WorkedMin="{Binding WorkedMin}" ExtraMin="{Binding ExtraMin}" CapMin="{Binding CapMin}" Height="16" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Caja de Alertas -->
                            <Border Background="{DynamicResource WarnSoftBrush}"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    IsVisible="{Binding HasAlerts}">
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <controls:Icon Data="{DynamicResource IconWarn}" Size="14" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 3. TARJETA REGISTRO DE JORNADA -->
                <Border Classes="card d4">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Registro de jornada" Classes="h2" />
                            <TextBlock Grid.Column="1" Text="{Binding PeriodLabel}" Classes="caption" />
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <StackPanel MinWidth="940" Spacing="2">
                                <!-- Cabecera fija -->
                                <Border Padding="0,0,0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid ColumnDefinitions="140,66,92,62,62,62,62,62,52,*,84" ColumnSpacing="6">
                                        <TextBlock Text="FECHA" Classes="caption" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="DESCANSO" Classes="caption" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="RÁPIDO" Classes="caption" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="ENT. 1" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="SAL. 1" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="ENT. 2" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="SAL. 2" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="DESC. MIN" Classes="caption" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="8" Text="HORAS" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="9" Text="CLASIFICACIÓN" Classes="caption" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="10" Text="RECARGOS" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <!-- Filas de días -->
                                <ItemsControl ItemsSource="{Binding DayRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DayRowViewModel">
                                            <Border Classes="dayrow"
                                                    Classes.outside="{Binding !InPeriod}"
                                                    Padding="0,3"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource BorderBrush}">

                                                <Grid ColumnDefinitions="140,66,92,62,62,62,62,62,52,*,84" ColumnSpacing="6" VerticalAlignment="Center">
                                                    <!-- Fecha -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DateLabel}"
                                                                   Classes.dom="{Binding IsDom}" />
                                                        <Border IsVisible="{Binding IsFest}" CornerRadius="4" Background="{DynamicResource WarnSoftBrush}" Padding="4,1">
                                                            <TextBlock Text="festivo" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" />
                                                        </Border>
                                                        <TextBlock Text="· fuera" Classes="caption" IsVisible="{Binding !InPeriod}" />
                                                    </StackPanel>
                                                    <!-- Descanso -->
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding Rest}"
                                                              Click="OnDayRestClick"
                                                              VerticalAlignment="Center" />
                                                    <!-- Rápido -->
                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding $parent[UserControl].((vm:LiquidacionViewModel)DataContext).QuickShifts}"
                                                              SelectedIndex="0"
                                                              SelectionChanged="OnPresetSelectionChanged"
                                                              FontSize="11.5"
                                                              Padding="4,3"
                                                              HorizontalAlignment="Stretch" />
                                                    <!-- In1 / Out1 -->
                                                    <TextBox Grid.Column="3" Text="{Binding In1, Mode=OneWay}" Tag="in1" HorizontalContentAlignment="Center" LostFocus="OnTimeBoxLostFocus" KeyDown="OnTimeBoxKeyDown" />
                                                    <TextBox Grid.Column="4" Text="{Binding Out1, Mode=OneWay}" Tag="out1" HorizontalContentAlignment="Center" LostFocus="OnTimeBoxLostFocus" KeyDown="OnTimeBoxKeyDown" />
                                                    <!-- In2 / Out2 -->
                                                    <TextBox Grid.Column="5" Text="{Binding In2, Mode=OneWay}" Tag="in2" HorizontalContentAlignment="Center" LostFocus="OnTimeBoxLostFocus" KeyDown="OnTimeBoxKeyDown" />
                                                    <TextBox Grid.Column="6" Text="{Binding Out2, Mode=OneWay}" Tag="out2" HorizontalContentAlignment="Center" LostFocus="OnTimeBoxLostFocus" KeyDown="OnTimeBoxKeyDown" />
                                                    <!-- Brk -->
                                                    <TextBox Grid.Column="7" Text="{Binding BrkText, Mode=OneWay}" Tag="brk" HorizontalContentAlignment="Center" LostFocus="OnBrkBoxLostFocus" KeyDown="OnTimeBoxKeyDown" />
                                                    <!-- Horas -->
                                                    <TextBlock Grid.Column="8" Text="{Binding DayHoursFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Medium" />
                                                    <!-- Clasificación -->
                                                    <WrapPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                   Classes="caption"
                                                                   Classes.dom="{Binding IsWorkedRest}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center" />
                                                        <ItemsControl ItemsSource="{Binding Chips}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:DayChipItem">
                                                                    <Border Classes="chip"
                                                                            Background="{Binding Cat, Converter={x:Static conv:CategoryBrushConverter.Background}}"
                                                                            Margin="0,0,4,2">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   Foreground="{Binding Cat, Converter={x:Static conv:CategoryBrushConverter.Foreground}}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                    <!-- Recargos -->
                                                    <TextBlock Grid.Column="10" Text="{Binding DayAmountFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Leyenda de categorías y acciones -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{Binding Legend}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LegendItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,4">
                                                <Border Classes="chip"
                                                        Background="{Binding Cat, Converter={x:Static conv:CategoryBrushConverter.Background}}">
                                                    <TextBlock Text="{Binding ShortLabel}"
                                                               Foreground="{Binding Cat, Converter={x:Static conv:CategoryBrushConverter.Foreground}}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Escribe la hora como 8:30, 0830 o 14 y confirma con Enter o Tab." Classes="caption" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClearPeriodHoursCommand}" Classes="ghost">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:Icon Data="{DynamicResource IconTrash}" Size="14" Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="Limpiar horas del periodo" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 4. AUDITORÍA + LIQUIDACIÓN -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <!-- Tarjeta Auditoría -->
                    <Border Classes="card d5">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Auditoría" Classes="h2" />
                            <TextBlock Text="{Binding BaseHourLabel}" Classes="sub" />
                            <Grid ColumnDefinitions="*,64,160,84,46" Margin="0,4,0,2">
                                <TextBlock Text="CONCEPTO" Classes="caption" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="HORAS" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="VALOR/HORA" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="TOTAL" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="%" Classes="caption" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AuditRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuditRowViewModel">
                                        <Border Padding="0,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                                            <Grid ColumnDefinitions="*,64,160,84,46">
                                                <TextBlock Text="{Binding Concepto}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding HorasFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding RateFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption" />
                                                <TextBlock Grid.Column="3" Text="{Binding TotalFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBlock Grid.Column="4" Text="{Binding PercentageFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Total -->
                            <Grid ColumnDefinitions="*,64,160,84,46" Margin="0,6,0,0">
                                <TextBlock Text="Total" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalHoursFormatted}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding TotalRecargosFormatted}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- Tarjeta Liquidación -->
                    <Border Grid.Column="1" Classes="card d6">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Liquidación" Classes="h2" />
                                <TextBlock Grid.Column="1" Text="{Binding PeriodLabel}" Classes="caption" />
                            </Grid>
                            <!-- Modo con sueldo incluido -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsInclSueldo}">
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Salario básico quincenal" /><TextBlock Grid.Column="1" Text="{Binding BasicoQuincenal}" /></Grid>
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Auxilio de transporte" /><TextBlock Grid.Column="1" Text="{Binding AuxilioTransporte}" /></Grid>
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Recargos y horas extra" /><TextBlock Grid.Column="1" Text="{Binding RecargosQuincenal}" /></Grid>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Total devengado" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding TotalDevengado}" FontWeight="SemiBold" /></Grid>
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SaludLabel}" /><TextBlock Grid.Column="1" Text="{Binding SaludDescuento}" /></Grid>
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding PensionLabel}" /><TextBlock Grid.Column="1" Text="{Binding PensionDescuento}" /></Grid>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Neto a pagar" Classes="h2" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding NetoPagar}" Classes="h1" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding DeduccionesNota}" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Modo solo recargos -->
                            <StackPanel Spacing="8" IsVisible="{Binding !IsInclSueldo}">
                                <TextBlock Text="{Binding TotalRecargosFormatted}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="Solo recargos y horas extra. El sueldo básico se paga aparte." Classes="sub" />
                            </StackPanel>
                            <!-- Botones Exportar -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Button Command="{Binding ExportPdfCommand}" Classes="primary">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <controls:Icon Data="{DynamicResource IconFilePdf}" Size="16" Foreground="{DynamicResource OnPrimaryBrush}" />
                                        <TextBlock Text="PDF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportExcelCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <controls:Icon Data="{DynamicResource IconFileXls}" Size="16" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="Excel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
