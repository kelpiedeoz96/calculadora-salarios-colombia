
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CalculadoraDeSalarios.App.Controls"
        xmlns:converters="clr-namespace:CalculadoraDeSalarios.App.Converters"
        xmlns:views="clr-namespace:CalculadoraDeSalarios.App.Views"
        xmlns:vm="clr-namespace:CalculadoraDeSalarios.App.ViewModels"
        xmlns:vmliq="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Liquidacion"
        xmlns:vmemp="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Empleados"
        xmlns:vmpanel="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Panel"
        xmlns:vmcal="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Calendario"
        xmlns:vmhist="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Historial"
        xmlns:vmcfg="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Ajustes"
        x:Class="CalculadoraDeSalarios.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Nómina · Mi Empresa"
        Icon="/Assets/icon.png"
        Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:ResourceKeyToGeometryConverter x:Key="ResToGeo" />
    </Window.Resources>
    <Window.DataTemplates>
        <!-- Pestaña Liquidación terminada -->
        <DataTemplate DataType="{x:Type vmliq:LiquidacionViewModel}">
            <views:LiquidacionView />
        </DataTemplate>
        <!-- Placeholders de las demás pantallas -->
        <DataTemplate DataType="{x:Type vmpanel:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmemp:EmpleadosViewModel}">
            <views:EmpleadosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmcal:CalendarioViewModel}">
            <views:CalendarioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmhist:HistorialViewModel}">
            <views:HistorialView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmcfg:AjustesViewModel}"><views:AjustesView /></DataTemplate>
    </Window.DataTemplates>
    <Grid>
        <Grid ColumnDefinitions="Auto,*">
            <!-- 1. SIDEBAR IZQUIERDA -->
            <Border Grid.Column="0"
                    Classes="sidebar"
                    Width="{Binding SidebarWidth}"
                    Padding="10">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.15" />
                    </Transitions>
                </Border.Transitions>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <StackPanel Grid.Row="0" Spacing="8" Margin="4,8,4,4">
                        <Image Source="{Binding LogoBitmap}"
                               Height="44"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               IsVisible="{Binding LogoBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel IsVisible="{Binding !IsSidebarCollapsed}" Spacing="2">
                            <TextBlock Text="Nómina" Classes="h2" />
                            <TextBlock Text="{Binding State.Cfg.RazonSocial}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="PRINCIPAL"
                                       Classes="caption"
                                       FontWeight="SemiBold"
                                       Margin="8,8,0,4"
                                       IsVisible="{Binding !IsSidebarCollapsed}" />
                            <ItemsControl ItemsSource="{Binding PrincipalNavItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NavItemViewModel">
                                        <Button Classes="nav"
                                                Classes.active="{Binding IsActive}"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateCommand}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding ShortcutTip}">
                                            <Grid>
                                                <Border Classes="navbar" Classes.on="{Binding IsActive}"
                                                        Width="3" Height="18" CornerRadius="2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="-10,0,0,0" IsHitTestVisible="False" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                <controls:Icon Data="{Binding IconKey, Converter={StaticResource ResToGeo}}" Size="18" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsSidebarCollapsed}" />
                                            </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="SISTEMA"
                                       Classes="caption"
                                       FontWeight="SemiBold"
                                       Margin="8,16,0,4"
                                       IsVisible="{Binding !IsSidebarCollapsed}" />
                            <ItemsControl ItemsSource="{Binding SistemaNavItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NavItemViewModel">
                                        <Button Classes="nav"
                                                Classes.active="{Binding IsActive}"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateCommand}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding ShortcutTip}">
                                            <Grid>
                                                <Border Classes="navbar" Classes.on="{Binding IsActive}"
                                                        Width="3" Height="18" CornerRadius="2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="-10,0,0,0" IsHitTestVisible="False" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                <controls:Icon Data="{Binding IconKey, Converter={StaticResource ResToGeo}}" Size="18" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsSidebarCollapsed}" />
                                            </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="4">
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Classes="ghost"
                                HorizontalAlignment="Stretch"
                                Padding="8,7"
                                ToolTip.Tip="Contraer / expandir barra lateral (Ctrl+B)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:Icon Data="{DynamicResource IconChevronL}" Size="16" />
                                <TextBlock Text="Contraer menú" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 2. ZONA PRINCIPAL -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- Topbar -->
                <Border Grid.Row="0"
                        Classes="topbar"
                        MinHeight="60"
                        Padding="24,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Título y Subtítulo dinámicos -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding CurrentTitle}" Classes="h2" />
                            <TextBlock Text="{Binding CurrentSubtitle}" Classes="caption" />
                        </StackPanel>
                        <!-- Controles de la derecha: Selector de periodo, tema y comandos -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Flecha Anterior -->
                            <Button Command="{Binding PrevPeriodCommand}"
                                    Classes="icon-btn ghost"
                                    ToolTip.Tip="Periodo anterior">
                                <controls:Icon Data="{DynamicResource IconChevronL}" Size="16" />
                            </Button>
                            <!-- Selector con Flyout -->
                            <Button Name="PeriodButton" Content="{Binding PeriodLabel}" Padding="12,6">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Border Width="330" Background="{DynamicResource SurfaceBrush}" Padding="16">
                                            <StackPanel Spacing="14">
                                                <TextBlock Text="Elegir Periodo de Nómina" Classes="h2" />
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                    <Button Command="{Binding PrevFlyoutMonthCommand}" Classes="icon-btn ghost">
                                                        <controls:Icon Data="{DynamicResource IconChevronL}" Size="14" />
                                                    </Button>
                                                    <TextBox Grid.Column="1" Text="{Binding FlyoutMonth}" HorizontalContentAlignment="Center" />
                                                    <Button Command="{Binding NextFlyoutMonthCommand}" Classes="icon-btn ghost">
                                                        <controls:Icon Data="{DynamicResource IconChevronR}" Size="14" />
                                                    </Button>
                                                </Grid>
                                                <ComboBox SelectedIndex="{Binding FlyoutModeIndex}" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="1ª quincena (1–15)" />
                                                    <ComboBoxItem Content="2ª quincena (16–fin)" />
                                                    <ComboBoxItem Content="Rango propio" />
                                                </ComboBox>
                                                <StackPanel Spacing="6" IsVisible="{Binding IsFlyoutCustomRange}">
                                                    <TextBlock Text="Desde (AAAA-MM-DD)" Classes="caption" />
                                                    <TextBox Text="{Binding FlyoutFrom}" PlaceholderText="2026-10-01" />
                                                    <TextBlock Text="Hasta (AAAA-MM-DD)" Classes="caption" />
                                                    <TextBox Text="{Binding FlyoutTo}" PlaceholderText="2026-10-15" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FlyoutError}"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding FlyoutError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <Button Content="Aplicar periodo" Classes="primary" HorizontalAlignment="Stretch" Command="{Binding ApplyFlyoutPeriodCommand}" />
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <!-- Flecha Siguiente -->
                            <Button Command="{Binding NextPeriodCommand}"
                                    Classes="icon-btn ghost"
                                    ToolTip.Tip="Periodo siguiente">
                                <controls:Icon Data="{DynamicResource IconChevronR}" Size="16" />
                            </Button>
                            <!-- Conmutador de tema -->
                            <Button Command="{Binding CycleThemeCommand}"
                                    Classes="icon-btn ghost"
                                    ToolTip.Tip="Cambiar tema (Claro / Oscuro / Sistema)">
                                <controls:Icon Data="{DynamicResource IconSun}" Size="16" />
                            </Button>
                            <!-- Botón paleta de comandos -->
                            <Button Command="{Binding OpenCommandPaletteCommand}"
                                    Classes="ghost"
                                    ToolTip.Tip="Paleta de comandos (Ctrl+K)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:Icon Data="{DynamicResource IconSearch}" Size="16" />
                                    <TextBlock Text="Comandos" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Área de contenido del módulo activo -->
                <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentContentViewModel}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.22" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Grid>
        </Grid>
        <!-- 3. HOST SUPERPUESTO DE TOASTS -->
        <ItemsControl ItemsSource="{Binding ActiveToasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,24"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastItemViewModel">
                    <Border Classes="toast"
                            Classes.ok="{Binding IsOk}"
                            Classes.warn="{Binding IsWarn}"
                            Classes.danger="{Binding IsDanger}"
                            Classes.info="{Binding IsInfo}"
                            Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:Icon Data="{Binding IconKey, Converter={StaticResource ResToGeo}}"
                                           Size="16"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Message}"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
