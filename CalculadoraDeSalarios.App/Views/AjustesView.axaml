<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CalculadoraDeSalarios.App.Controls"
             xmlns:vm="clr-namespace:CalculadoraDeSalarios.App.ViewModels.Ajustes"
             x:Class="CalculadoraDeSalarios.App.Views.AjustesView"
             x:DataType="vm:AjustesViewModel">
    <ScrollViewer Padding="28,20,28,40">
        <StackPanel Spacing="16">
            <!-- 1) Jornada | Minutos -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card d1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Jornada" Classes="h2" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <controls:CampoAjusteControl Grid.Column="0" DataContext="{Binding TopeSemanal}" />
                            <controls:CampoAjusteControl Grid.Column="1" DataContext="{Binding JornadaDiariaRef}" />
                        </Grid>
                        <CheckBox Content="Contar como extra lo que pase de la jornada diaria" IsChecked="{Binding DailyCapOn, Mode=OneWay}" Tag="DailyCapOn" Click="OnCheckBoxClick" />
                        <TextBlock Text="Apagado: solo el tope semanal cuenta, como se liquida actualmente." FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <controls:CampoAjusteControl Grid.Column="0" DataContext="{Binding NocturnaDesde}" />
                            <controls:CampoAjusteControl Grid.Column="1" DataContext="{Binding NocturnaHasta}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card d2">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Minutos" Classes="h2" />
                        <CheckBox Content="Regla de minutos en la hora de salida" IsChecked="{Binding MinuteRuleOn, Mode=OneWay}" Tag="MinuteRuleOn" Click="OnCheckBoxClick" />
                        <TextBlock Text="Si los minutos de la salida son menos del mínimo, se redondean hacia abajo (9:29 → 9:00). Si llegan al mínimo, se pagan reales." FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
                        <controls:CampoAjusteControl DataContext="{Binding MinutosMinimos}" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 2) Recargos -->
            <Border Classes="card d3">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recargos (%)" Classes="h2" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <controls:CampoAjusteControl Grid.Column="0" DataContext="{Binding RecargoNocturno}" />
                        <controls:CampoAjusteControl Grid.Column="1" DataContext="{Binding ExtraDiurna}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <controls:CampoAjusteControl Grid.Column="0" DataContext="{Binding ExtraNocturna}" />
                        <controls:CampoAjusteControl Grid.Column="1" DataContext="{Binding Dominical}" />
                    </Grid>
                    <CheckBox Content="Subir el dominical a 100% desde el 1 de julio de 2027" IsChecked="{Binding DomAutoOn, Mode=OneWay}" Tag="DomAutoOn" Click="OnCheckBoxClick" />
                    <TextBlock Text="Los combinados se suman automáticamente. El dominical es 90% hasta el 30 de junio de 2027 y 100% desde el 1 de julio de 2027 (Ley 2466 de 2025). Si pones un porcentaje mayor, se respeta." FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
                    <controls:CampoAjusteControl DataContext="{Binding Divisor}" />
                    <CheckBox Content="Redondear valor hora al peso" IsChecked="{Binding RateRound, Mode=OneWay}" Tag="RateRound" Click="OnCheckBoxClick" />
                    <CheckBox Content="Ordinarias dominicales suman valor completo" IsChecked="{Binding DomOrdFull, Mode=OneWay}" Tag="DomOrdFull" Click="OnCheckBoxClick" />
                    <TextBlock Text="Nota: esta casilla no cambia el cálculo, igual que en la app anterior." FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <!-- 3) Sueldo y descuentos | Turnos rápidos -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card d4">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Sueldo y descuentos" Classes="h2" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <controls:CampoAjusteControl Grid.Column="0" DataContext="{Binding Smmlv}" />
                            <controls:CampoAjusteControl Grid.Column="1" DataContext="{Binding Auxilio}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <controls:CampoAjusteControl Grid.Column="0" DataContext="{Binding SaludPct}" />
                            <controls:CampoAjusteControl Grid.Column="1" DataContext="{Binding PensionPct}" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Descuentos sobre" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Text3Brush}" />
                            <ComboBox SelectedIndex="{Binding DeductBaseIndex, Mode=OneWay}"
                                      SelectionChanged="OnDeductBaseSelectionChanged"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Solo salario básico" />
                                <ComboBoxItem Content="Básico + recargos" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card d5">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Turnos rápidos" Classes="h2" />
                        <controls:CampoAjusteControl DataContext="{Binding TurnosRapidos}" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 4) Festivos -->
            <Border Classes="card d6">
                <StackPanel Spacing="12">
                    <TextBlock Text="Festivos" Classes="h2" />
                    <controls:CampoAjusteControl DataContext="{Binding Festivos}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding AnioFestivos}" Width="90" PlaceholderText="Año" />
                        <Button Command="{Binding AgregarFestivosAnioCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconPlus}" Size="16" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Agregar festivos de ese año" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Se agregan solos los festivos del año actual y del siguiente si faltan. Están calculados con la Ley Emiliani; revísalos contra el calendario oficial." FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <!-- 5) Datos de la empresa -->
            <Border Classes="card d7">
                <StackPanel Spacing="14">
                    <TextBlock Text="Datos de la empresa" Classes="h2" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <controls:CampoAjusteControl Grid.Column="0" DataContext="{Binding RazonSocial}" />
                        <controls:CampoAjusteControl Grid.Column="1" DataContext="{Binding Nit}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Width="96" Height="80">
                            <Image Source="{Binding LogoBitmap}" Height="64" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding LogoEtiqueta}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="El logo y los datos de la empresa se usan en los PDF y Excel." FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding ElegirLogoCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:Icon Data="{DynamicResource IconUpload}" Size="16" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="Elegir logo…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="danger" Command="{Binding QuitarLogoCommand}" IsVisible="{Binding HasCustomLogo}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:Icon Data="{DynamicResource IconTrash}" Size="16" Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="Quitar logo personalizado" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- 6) Respaldos -->
            <Border Classes="card d8">
                <StackPanel Spacing="14">
                    <TextBlock Text="Respaldos" Classes="h2" />
                    <TextBlock Text="La app guarda sola un .zip con tus datos, ajustes, historial, fotos y logo cuando hay cambios nuevos (al abrir y al cerrar, máximo uno por hora)."
                               FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UltimoRespaldoTexto}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Carpeta de respaldos" FontSize="12" Foreground="{DynamicResource Text3Brush}" />
                        <TextBlock Text="{Binding CarpetaRespaldosTexto}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Carpeta extra (USB, Dropbox, otro disco…)" FontSize="12" Foreground="{DynamicResource Text3Brush}" />
                        <TextBlock Text="{Binding CarpetaExtraTexto}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="primary" Command="{Binding RespaldarAhoraCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconDownload}" Size="16" Foreground="White" />
                                <TextBlock Text="Respaldar ahora" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AbrirCarpetaRespaldosCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconFile}" Size="16" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Abrir carpeta" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ElegirCarpetaExtraCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconUpload}" Size="16" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Elegir carpeta extra…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="danger" Command="{Binding QuitarCarpetaExtraCommand}" IsVisible="{Binding HayCarpetaExtra}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconX}" Size="16" Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="Quitar carpeta extra" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="danger" Command="{Binding RestaurarRespaldoCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{DynamicResource IconHistory}" Size="16" Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="Restaurar desde un respaldo…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
