<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CalculadoraDeSalarios.App.Views.ConfirmDialogWindow"
        Title="Confirmación requerida"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceBrush}" Padding="24">
        <StackPanel Spacing="18">
            <TextBlock Name="TxtTitle" Classes="h2" Text="Confirmar operación" />
            <TextBlock Name="TxtMessage" TextWrapping="Wrap" LineHeight="20" Classes="sub" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Name="BtnCancel" Content="Cancelar" Classes="ghost" IsCancel="True" />
                <Button Name="BtnConfirm" Content="Confirmar" Classes="primary" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>

</Window>
