<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Calculadora de Salarios"
           Language="1034"
           Codepage="65001"
           Version="$(var.Version)"
           Manufacturer="Mi Empresa"
           UpgradeCode="cf7e0424-68fa-4a14-90c6-9337d09b1834">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="Calculadora de Salarios - calculadora de nómina" />

    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más nueva de Calculadora de Salarios instalada." />
    <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="NominaApp" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="AccesoMenuInicio" Guid="e6c6cd8d-6df4-48f4-b355-289844a6c9fa">
        <Shortcut Id="AccesoMenu" Name="Calculadora de Salarios" Target="[INSTALLDIR]CalculadoraDeSalarios.App.exe"
                  WorkingDirectory="INSTALLDIR" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\NominaApp" Name="AccesoMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="AccesoEscritorio" Guid="78b86954-f962-40a6-90a3-2ac09b7862aa">
        <Shortcut Id="AccesoDesk" Name="Calculadora de Salarios" Target="[INSTALLDIR]CalculadoraDeSalarios.App.exe"
                  WorkingDirectory="INSTALLDIR" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\NominaApp" Name="AccesoEscritorio" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Principal" Title="Calculadora de Salarios" Level="1">
      <ComponentGroupRef Id="ArchivosApp" />
      <ComponentRef Id="AccesoMenuInicio" />
      <ComponentRef Id="AccesoEscritorio" />
    </Feature>
  </Product>
</Wix>
